# Local development only. Copy to .env to override the safe compose defaults.
MYSQL_DATABASE=saving
MYSQL_USER=saving_app
MYSQL_PASSWORD=saving-local-app
MYSQL_ROOT_PASSWORD=saving-local-root
MYSQL_PORT=3306
WEB_PORT=5173
# Set this to the public HTTPS origin before enabling production authentication.
APP_BASE_URL=http://localhost:5173
# Keep false for local HTTP. Set true when the site is served over HTTPS.
COOKIE_SECURE=false
# SMTP is required to deliver email verification and password reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: set the token for a remotely-managed Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
