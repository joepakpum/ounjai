# Local Podman Compose defaults. Replace database credentials before any public deployment.
WEB_PORT=5173
MYSQL_PORT=3306
MYSQL_DATABASE=saving
MYSQL_USER=saving_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=false

# Gmail SMTP uses an App Password when 2-Step Verification is enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set to the email that should receive Super Admin privileges after verification.
SYSTEM_ADMIN_EMAIL=

# Leave empty until the domain security gate is complete and the owner approves enabling the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
