# Local development only. Copy to .env to override the safe compose defaults.
MYSQL_DATABASE=saving
MYSQL_USER=saving_app
MYSQL_PASSWORD=saving-local-app
MYSQL_ROOT_PASSWORD=saving-local-root
MYSQL_PORT=3306
WEB_PORT=5173
# Optional: set the token for a remotely-managed Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
